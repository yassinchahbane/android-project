<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cosmic_bg"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- Custom Decorative Gradient Accent Logo Backdrop -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨"
            android:textSize="54sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chahbane"
            android:textSize="38sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-condensed-light"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCAL LLM CHAT"
            android:textSize="14sp"
            android:letterSpacing="0.2"
            android:textColor="@color/cyan_accent"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/glow_highlight" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECURE &amp; LOCAL RAG DEEPSEEK SYSTEM"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textColor="@color/text_secondary"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />

</RelativeLayout>
